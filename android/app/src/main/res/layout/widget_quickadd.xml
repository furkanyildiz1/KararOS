<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/widget_bg"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- Sol: Uygulama ikonu -->
    <ImageView
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@mipmap/ic_launcher_round"
        android:contentDescription="KararOS" />

    <!-- Orta: Başlık + Açıklama -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="KararOS"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.02"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sesli harcama ekle"
            android:textColor="#A0B4CC"
            android:textSize="10sp"
            android:layout_marginTop="1dp"
            android:maxLines="1"
            android:ellipsize="end" />

    </LinearLayout>

    <!-- Sağ: Mikrofon ikonu (Asla taşmaz ve kırpılmaz) -->
    <ImageView
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/widget_mic_icon"
        android:contentDescription="Sesli Giriş"
        android:background="@drawable/widget_mic_bg"
        android:padding="5dp" />

</LinearLayout>

