{
  "expo": {
    "name": "KararOS",
    "slug": "KararOS",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kararos",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.kararos.app",
      "buildNumber": "1",
      "supportsTablet": false
    },
    "android": {
      "package": "com.kararos.app",
      "permissions": [
        "RECORD_AUDIO",
        "RECEIVE_BOOT_COMPLETED",
        "SCHEDULE_EXACT_ALARM"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#070E1A",
        "foregroundImage": "./assets/images/icon.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "targetSdkVersion": 36,
      "minSdkVersion": 24
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#070E1A",
          "image": "./assets/images/icon.png",
          "imageWidth": 120
        }
      ],
      "expo-image",
      "expo-speech-recognition",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "QuickAdd",
              "label": "KararOS Hızlı Ekle"
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fc1b951e-e9f8-4d0b-9bb9-8b4311a244a5"
      },
      "sentryDsn": "https://9113a1411409c52661ea57e360de4b74@o4512216703565824.ingest.de.sentry.io/4512216712740944"
    },
    "owner": "furkan54"
  }
}
